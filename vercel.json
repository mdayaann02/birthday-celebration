{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "http://155.248.255.29:3000/uploads/$1"
    },
    {
      "source": "/api/upload-chunk",
      "destination": "http://155.248.255.29:3000/api/upload-chunk"
    },
    {
      "source": "/api/museum/(.*)",
      "destination": "http://155.248.255.29:3000/api/museum/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
